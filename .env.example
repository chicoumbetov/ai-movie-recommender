# Local default: Ollama, $0 path.
OPENAI_API_KEY=ollama
OPENAI_BASE_URL=http://127.0.0.1:11434/v1
MODEL=qwen3.5:4b
REASONING_EFFORT=none

# Cloud benchmark profile for `uv run check.py --profile cloud` (Rare R05).
OPENAI_CLOUD_BASE_URL=https://api.openai.com/v1
OPENAI_CLOUD_API_KEY=
OPENAI_CLOUD_MODEL=gpt-6-luna

# One-off catalog build.
TMDB_API_KEY=

# Telegram bot.
TELEGRAM_BOT_TOKEN=
TELEGRAM_API_BASE=https://api.telegram.org
BOT_STATE_PATH=state.json
TELEGRAM_POLL_TIMEOUT_SECONDS=30
TELEGRAM_MAX_MESSAGE_CHARS=4096
MAX_CLARIFY_TURNS=1

# check.py.
CHECK_RUNS=1
